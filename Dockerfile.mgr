# Stage 1: builder
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/katamaran-mgr/ cmd/katamaran-mgr/
COPY internal/ internal/
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false -mod=readonly \
    -ldflags "-X github.com/maci0/katamaran/internal/buildinfo.Version=${VERSION}" \
    -o /katamaran-mgr ./cmd/katamaran-mgr/

# Stage 2: minimal runtime
FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
ARG VERSION=dev
RUN addgroup -g 1000 mgr && adduser -D -u 1000 -G mgr mgr
COPY --from=builder /katamaran-mgr /usr/local/bin/katamaran-mgr
USER mgr
EXPOSE 8081 9443
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:8081/healthz || exit 1
LABEL org.opencontainers.image.title="katamaran-mgr" \
      org.opencontainers.image.source="https://github.com/maci0/katamaran" \
      org.opencontainers.image.documentation="https://github.com/maci0/katamaran/blob/main/docs/INSTALL.md" \
      org.opencontainers.image.description="Katamaran Migration CRD controller" \
      org.opencontainers.image.version="${VERSION}"
ENTRYPOINT ["/usr/local/bin/katamaran-mgr"]
