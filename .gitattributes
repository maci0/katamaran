# Normalize text files to LF in the repo. Executable content in this
# project (bash scripts, Dockerfiles, Makefile) breaks when checked out
# with CRLF, so force LF on disk for every platform, not just in the
# object store.
* text=auto

*.go   text eol=lf
*.sh   text eol=lf
*.bash text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
.gitignore    text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
Makefile       text eol=lf
Dockerfile     text eol=lf
Dockerfile.*   text eol=lf

# Binary artifacts: never normalize.
*.png  binary
*.tar  binary
