FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/katamaran-dashboard/ cmd/katamaran-dashboard/
COPY internal/ internal/
ARG VERSION=dev
ENV GOTOOLCHAIN=local
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false -mod=readonly \
    -ldflags "-X github.com/maci0/katamaran/internal/buildinfo.Version=${VERSION} -B none -buildid=" \
    -o /dashboard ./cmd/katamaran-dashboard/

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# iputils is required for the loadgen ICMP ping path. kubectl, bash, and
# envsubst (gettext) are no longer shipped because the dashboard uses the
# in-process Native orchestrator (client-go). Use katamaran-orchestrator
# with --script when you need the legacy migrate.sh path locally.
RUN apk add --no-cache iputils

RUN addgroup -g 1000 dashboard && \
    adduser -D -u 1000 -G dashboard dashboard

WORKDIR /app
COPY --chown=dashboard:dashboard --from=builder /dashboard .

USER dashboard
EXPOSE 8080
# busybox provides wget; the image ships no standalone wget binary.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/bin/busybox", "wget", "-q", "--spider", "http://localhost:8080/healthz"]
ARG VERSION=dev
LABEL org.opencontainers.image.title="katamaran-dashboard" \
      org.opencontainers.image.source="https://github.com/maci0/katamaran" \
      org.opencontainers.image.documentation="https://github.com/maci0/katamaran/blob/main/docs/INSTALL.md" \
      org.opencontainers.image.description="Katamaran migration dashboard" \
      org.opencontainers.image.version="${VERSION}"

# The server exits on SIGTERM (cmd/katamaran-dashboard/main.go).
ENTRYPOINT ["/app/dashboard"]
STOPSIGNAL SIGTERM
